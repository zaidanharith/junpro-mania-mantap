<UserControl x:Class="BOZea.Views.Product.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:BOZea.Views.Shared"
             mc:Ignorable="d"
             FontFamily="Plus Jakarta Sans">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BOZea;component/Views/Styles/MaterialOverrides.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- NavBar (Fixed) -->
            <RowDefinition Height="*"/>
            <!-- ScrollableContent + Footer -->
        </Grid.RowDefinitions>

        <!-- NavBar (Fixed - tidak scroll) -->
        <shared:NavBar Grid.Row="0"/>

        <!-- Scrollable Content (dengan Footer di dalam) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Product Header Button -->
                <Grid Margin="80,40,80,0">
                    <Button Command="{Binding NavigateHomeCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            Padding="0"
                            Height="45">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#333"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Back to Dashboard"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="#333"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>


                <!-- Product Detail Section -->
                <Grid Margin="80,30,80,60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Product Image -->
                    <Border Background="#D3D3D3"
                            CornerRadius="12"
                            Height="320"
                            Margin="0,0,40,0">
                        <Image Source="{Binding Product.ImageUrl}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- Product Info -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top"
                                Margin="20,0,0,0">
                        <!-- Product Name -->
                        <TextBlock Text="{Binding Product.ProductName}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <!-- Category -->
                        <TextBlock Text="{Binding Product.Category}"
                                   FontSize="16"
                                   Foreground="#666"
                                   Margin="0,0,0,20"/>

                        <!-- Price -->
                        <TextBlock Text="{Binding FormattedPrice}"
                                   FontSize="28"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource PrimaryBlueBrush}"
                                   Margin="0,0,0,25"/>

                        <!-- Description -->
                        <TextBlock Text="{Binding Product.Description}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   Foreground="#333"
                                   Margin="0,0,0,25"/>

                        <!-- Buy Now Button - PREMIUM STYLE -->
                        <Button Style="{StaticResource PremiumBuyButton}"
                                Command="{Binding BuyNowCommand}"
                                Margin="0,0,0,30"
                                HorizontalAlignment="Left"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1"/>
                            </Button.RenderTransform>
                            <TextBlock Text="🛒 Buy Now"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                    Margin="16,8,16,8"/>
                        </Button>
                        <!-- Additional Info -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Center">
                            <Border Background="#E8F5E9"
                                    CornerRadius="6"
                                    Padding="12,0"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Height="28">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="✓"
                                               Foreground="#4CAF50"
                                               FontWeight="Bold"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Secure Payment"
                                               Foreground="#2E7D32"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Margin="0,5,0,5"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF3E0"
                                    CornerRadius="6"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Height="29">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🚚"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Fast Shipping"
                                               Foreground="#E65100"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,5,0,5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Customer Reviews Section -->
                <StackPanel Margin="80,0,80,60">
                    <!-- Reviews Title + See All Button -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Customer Reviews"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- See All Reviews Button -->
                        <Button Grid.Column="1"
                                Content="See All Reviews →"
                                Command="{Binding ViewAllReviewsCommand}"
                                Background="{StaticResource PrimaryBlueBrush}"
                                Foreground="White"
                                Padding="20,12"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                BorderThickness="0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#1A6BB8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Reviews Grid (4 columns) - Limited to first 4 reviews -->
                    <ItemsControl ItemsSource="{Binding ReviewsPreview}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"
                                             HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="12"
                                        Margin="0,0,30,30"
                                        Padding="20"
                                        Width="300"
                                        MinHeight="240"
                                        BorderThickness="1"
                                        BorderBrush="#E0E0E0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="2"
                                                          Opacity="0.08"
                                                          Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Star Rating -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Rating, StringFormat={}★★★★★}"
                                                       FontSize="16"
                                                       Foreground="#FFB800"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Rating, StringFormat={}{0}/5}"
                                                       FontSize="12"
                                                       Foreground="#999"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- User Info Row -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar Circle -->
                                            <Border Grid.Column="0"
                                                    Width="40"
                                                    Height="40"
                                                    CornerRadius="20"
                                                    Background="#E0E0E0"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding UserNameInitial}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Foreground="#666"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Username + Date -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserName}"
                                                           FontWeight="Bold"
                                                           FontSize="13"/>
                                                <TextBlock Text="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}"
                                                           FontSize="11"
                                                           Foreground="#999"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Review Title -->
                                        <TextBlock Text="{Binding Comment}"
                                                   FontWeight="Medium"
                                                   FontSize="13"
                                                   Margin="0,0,0,12"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="80"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Review Content (truncated) -->
                                        <TextBlock Text="{Binding Comment, StringFormat={}Helpful review...}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"
                                                   Foreground="#666"
                                                   MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Footer (Inside ScrollViewer) -->
                <shared:Footer/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>