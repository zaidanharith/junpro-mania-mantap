<UserControl x:Class="BOZea.Views.Shared.AdminSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FontFamily="Plus Jakarta Sans"
             d:DesignHeight="800"
             d:DesignWidth="250">

    <UserControl.Resources>
        
        <!-- Style dasar untuk border menu --><Style x:Key="SidebarMenuItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="15,0,15,10"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- Warna hover tetap biru gelap --><Setter Property="Background" Value="#0A4567"/> 
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
          STYLE UNTUK TEXTBLOCK DI DALAM MENU:
          Default: Putih.
          Trigger: Jika Border 'Ancestor' (induknya) memiliki Background warna putih ("#FFFFFF"),
          maka ubah Foreground (warna teks) menjadi biru tua ("#0D5785").
        --><Style x:Key="SidebarMenuTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/> <!-- Warna default (tidak aktif) --><Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <!-- REAKSI TERHADAP WARNA BACKGROUND AKTIF YANG BARU (PUTIH) --><DataTrigger Binding="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}" 
                             Value="#FFFFFF">
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          STYLE UNTUK ICON DI DALAM MENU:
          Sama seperti TextBlock, style ini bereaksi terhadap perubahan Background induknya.
        --><Style x:Key="SidebarMenuIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Foreground" Value="White"/> <!-- Warna default (tidak aktif) --><Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Style.Triggers>
                <!-- REAKSI TERHADAP WARNA BACKGROUND AKTIF YANG BARU (PUTIH) --><DataTrigger Binding="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}" 
                             Value="#FFFFFF">
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>

    <!-- Background utama sidebar (Biru Tua) --><Border Background="#0D5785"
            CornerRadius="0,20,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.1"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Logo + Menu -->
                <RowDefinition Height="*"/>
                <!-- Spacer -->
                <RowDefinition Height="Auto"/>
                <!-- Logout Button -->
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- Logo Section --><Border Margin="30,30,30,0"
                        HorizontalAlignment="Center"
                        Height="64">
                    <Image Source="/Views/Assets/logo_white.png"
                           Height="88"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="148"/>
                </Border>

                <!-- Admin Panel Label (Biru Muda) --><TextBlock Text="Admin Panel"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#B0D4E8" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Menu Items --><StackPanel>
                    
                    <!-- Dashboard --><Border Tag="Dashboard">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarMenuItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard">
                                        <!-- Background aktif kembali ke Putih --><Setter Property="Background" Value="#1E293B"/> 
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding BackToDashboardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard"
                                                     Style="{StaticResource SidebarMenuIconStyle}"/>
                            <TextBlock Text="Dashboard"
                                       Style="{StaticResource SidebarMenuTextStyle}" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Product Management --><Border Tag="ProductManagement">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarMenuItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="ProductManagement">
                                        <!-- Background aktif kembali ke Putih --><Setter Property="Background" Value="#1E293B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateProductManagementCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Package"
                                                     Style="{StaticResource SidebarMenuIconStyle}"/>
                            <TextBlock Text="Product Management"
                                       Style="{StaticResource SidebarMenuTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Order Management --><Border Tag="OrderManagement">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SidebarMenuItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="OrderManagement">
                                        <!-- Background aktif kembali ke Putih --><Setter Property="Background" Value="#1E293B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateOrderManagementCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShoppingOutline"
                                                     Style="{StaticResource SidebarMenuIconStyle}"/>
                            <TextBlock Text="Order Management"
                                       Style="{StaticResource SidebarMenuTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Spacer -->
            <Border Grid.Row="1"/>

            <!-- Logout Button (Di Bawah) -->
            <Border Grid.Row="2"
                    Margin="15,10,15,15">
                <Border Background="#DC3545"
                        CornerRadius="10,10,10,10"
                        Padding="12,4,12,4"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding LogoutCommand}"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#BD2130"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Logout"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>
                        <TextBlock Text="Logout"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>