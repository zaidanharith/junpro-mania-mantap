<UserControl x:Class="BOZea.Views.Admin.DashboardAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FontFamily="Plus Jakarta Sans"
             d:DesignWidth="1280"
             d:DesignHeight="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BOZea;component/Views/Styles/MaterialOverrides.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar with Rounded Corners -->
        <Border Grid.Column="0"
                Background="#0D5785"
                CornerRadius="0,20,20,0"
                Margin="0,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.1"
                                  Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo Section - Using same logo as NavBar -->
                <Border Margin="30,30,30,0"
                        HorizontalAlignment="Center"
                        Height="64">
                    <Image Source="/Views/Assets/logo_white.png"
                           Height="88"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Width="148"/>
                </Border>

                <!-- Admin Panel Label -->
                <TextBlock Text="Admin Panel"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#B0D4E8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Menu Items -->
                <StackPanel>
                    <!-- Dashboard -->
                    <Border Background="#0A4567"
                            CornerRadius="8"
                            Margin="15,0,15,10"
                            Padding="15,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="White"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard"
                                       FontSize="15"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Product Management -->
                    <Border Background="Transparent"
                            CornerRadius="8"
                            Margin="15,0,15,10"
                            Padding="15,12"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateProductManagementCommand}"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#0A4567"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Package"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="White"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="Product Management"
                                       FontSize="15"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Order Management -->
                    <Border Background="Transparent"
                            CornerRadius="8"
                            Margin="15,0,15,10"
                            Padding="15,12"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateOrderManagementCommand}"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#0A4567"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShoppingOutline"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="White"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="Order Management"
                                       FontSize="15"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <Border Background="Transparent"
                            CornerRadius="8"
                            Margin="15,0,15,10"
                            Padding="15,12"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateSettingsCommand}"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#0A4567"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="White"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="Settings"
                                       FontSize="15"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Margin="0,30,0,20"
                    Padding="40,0">
                <Grid Height="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Column="0"
                               Text="Dashboard"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="#113F67"
                               VerticalAlignment="Center"
                               Margin="0"/>

                    <!-- User Profile -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                        <StackPanel.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OpenProfileCommand}"/>
                        </StackPanel.InputBindings>

                        <StackPanel Margin="0,0,15,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Selamat Datang,"
                                       FontSize="16"
                                       Foreground="#666"
                                       HorizontalAlignment="Right"
                                       Margin="0"/>
                            <TextBlock Text="{Binding AdminName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#113F67"
                                       HorizontalAlignment="Right"
                                       Margin="0"/>
                        </StackPanel>

                        <Border Width="64"
                                Height="64"
                                Background="#E8F4F8"
                                CornerRadius="32"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Account"
                                                     Width="32"
                                                     Height="32"
                                                     Foreground="#0D5785"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dashboard Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="20,10,20,0"
                          Padding="40,0,40,40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Dashboard Cards -->
                    <UniformGrid Grid.Row="0"
                                 Columns="3"
                                 Margin="0,0,0,40">

                        <!-- Product Management Card -->
                        <Border Background="White"
                                CornerRadius="12"
                                Margin="0,0,20,0"
                                Padding="30"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding NavigateProductManagementCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="2"
                                                  Opacity="0.1"
                                                  Color="#000000"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="25"
                                                                      ShadowDepth="3"
                                                                      Opacity="0.15"
                                                                      Color="#227DCD"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        Background="#E8F4F8"
                                        CornerRadius="30"
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0">
                                    <materialDesign:PackIcon Kind="Package"
                                                             Width="30"
                                                             Height="30"
                                                             Foreground="#0D5785"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title + Description -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Product Management"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#113F67"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="lorem ipsum dolor sit amet"
                                               FontSize="16"
                                               Foreground="#666"
                                               TextWrapping="Wrap"
                                               Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Order Management Card -->
                        <Border Background="White"
                                CornerRadius="12"
                                Margin="0,0,20,0"
                                Padding="30"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding NavigateOrderManagementCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="2"
                                                  Opacity="0.1"
                                                  Color="#000000"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="25"
                                                                      ShadowDepth="3"
                                                                      Opacity="0.15"
                                                                      Color="#227DCD"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        Background="#E8F4F8"
                                        CornerRadius="30"
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0">
                                    <materialDesign:PackIcon Kind="ShoppingOutline"
                                                             Width="30"
                                                             Height="30"
                                                             Foreground="#0D5785"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title + Description -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Order Management"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#113F67"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="lorem ipsum dolor sit amet"
                                               FontSize="16"
                                               Foreground="#666"
                                               TextWrapping="Wrap"
                                               Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Settings Card -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="30"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding NavigateSettingsCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="2"
                                                  Opacity="0.1"
                                                  Color="#000000"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="25"
                                                                      ShadowDepth="3"
                                                                      Opacity="0.15"
                                                                      Color="#227DCD"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        Background="#E8F4F8"
                                        CornerRadius="30"
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0">
                                    <materialDesign:PackIcon Kind="Cog"
                                                             Width="30"
                                                             Height="30"
                                                             Foreground="#0D5785"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title + Description -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Settings"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#113F67"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="lorem ipsum dolor sit amet"
                                               FontSize="16"
                                               Foreground="#666"
                                               TextWrapping="Wrap"
                                               Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>