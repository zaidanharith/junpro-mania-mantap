<UserControl x:Class="BOZea.Views.Admin.DashboardAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:shared="clr-namespace:BOZea.Views.Shared"
             mc:Ignorable="d"
             FontFamily="Plus Jakarta Sans"
             d:DesignWidth="1280"
             d:DesignHeight="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BOZea;component/Views/Styles/MaterialOverrides.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <shared:AdminSidebar Grid.Column="0"
                             DataContext="{Binding}"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Margin="0,30,0,20"
                    Padding="40,0">
                <Grid Height="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Column="0"
                               Text="Dashboard"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="#113F67"
                               VerticalAlignment="Center"
                               Margin="0"/>

                    <!-- User Profile -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                        <StackPanel.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding OpenProfileCommand}"/>
                        </StackPanel.InputBindings>

                        <StackPanel Margin="0,0,15,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Selamat Datang,"
                                       FontSize="16"
                                       Foreground="#666"
                                       HorizontalAlignment="Right"
                                       Margin="0"/>
                            <TextBlock Text="{Binding AdminName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#113F67"
                                       HorizontalAlignment="Right"
                                       Margin="0"/>
                        </StackPanel>

                        <Border Width="64"
                                Height="64"
                                Background="#E8F4F8"
                                CornerRadius="32"
                                VerticalAlignment="Center">
                            <Border.Clip>
                                <EllipseGeometry Center="32,32"
                                                 RadiusX="32"
                                                 RadiusY="32"/>
                            </Border.Clip>

                            <Grid>
                                <!-- Profile Image dari CurrentUser -->
                                <Image Source="{Binding CurrentUser.Image}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="64"
                                       Height="64"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1.12"
                                                        ScaleY="1.12"/>
                                    </Image.RenderTransform>
                                </Image>

                                <!-- Fallback icon -->
                                <materialDesign:PackIcon Kind="Account"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#0D5785"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentUser.Image}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentUser.Image}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dashboard Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="20,10,20,0"
                          Padding="0,0,0,40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Dashboard Cards -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Product Management Card -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="30"
                                Cursor="Hand"
                                Margin="10"
                                Grid.Column="0">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding NavigateProductManagementCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="2"
                                                  Opacity="0.1"
                                                  Color="#000000"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="30"
                                                                      ShadowDepth="8"
                                                                      Opacity="0.25"
                                                                      Color="#227DCD"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        Background="#E8F4F8"
                                        CornerRadius="30"
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0">
                                    <materialDesign:PackIcon Kind="Package"
                                                             Width="30"
                                                             Height="30"
                                                             Foreground="#0D5785"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title + Description -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Product Management"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#113F67"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Kelola produk Anda"
                                               FontSize="14"
                                               Foreground="#666"
                                               TextWrapping="Wrap"
                                               Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Order Management Card -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="30"
                                Cursor="Hand"
                                Margin="10"
                                Grid.Column="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding NavigateOrderManagementCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="2"
                                                  Opacity="0.1"
                                                  Color="#000000"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="30"
                                                                      ShadowDepth="8"
                                                                      Opacity="0.25"
                                                                      Color="#227DCD"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        Background="#E8F4F8"
                                        CornerRadius="30"
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0">
                                    <materialDesign:PackIcon Kind="ShoppingOutline"
                                                             Width="30"
                                                             Height="30"
                                                             Foreground="#0D5785"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title + Description -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Order Management"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#113F67"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Kelola Pesanan Masuk"
                                               FontSize="14"
                                               Foreground="#666"
                                               TextWrapping="Wrap"
                                               Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>