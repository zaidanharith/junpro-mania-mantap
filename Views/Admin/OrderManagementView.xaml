<UserControl x:Class="BOZea.Views.Admin.OrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:shared="clr-namespace:BOZea.Views.Shared"
             mc:Ignorable="d"
             FontFamily="Plus Jakarta Sans"
             d:DesignWidth="1280"
             d:DesignHeight="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BOZea;component/Views/Styles/MaterialOverrides.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <shared:AdminSidebar Grid.Column="0"
                             DataContext="{Binding}"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Margin="0,30,0,20"
                    Padding="40,0">
                <Grid Height="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Column="0"
                               Text="Order Management"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="#113F67"
                               VerticalAlignment="Center"
                               Margin="0"/>

                    <!-- User Profile -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Cursor="Hand">

                        <StackPanel Margin="0,0,15,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Selamat Datang,"
                                       FontSize="16"
                                       Foreground="#666"
                                       HorizontalAlignment="Right"
                                       Margin="0"/>
                            <TextBlock Text="{Binding AdminName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#113F67"
                                       HorizontalAlignment="Right"
                                       Margin="0"/>
                        </StackPanel>

                        <Border Width="64"
                                Height="64"
                                Background="#E8F4F8"
                                CornerRadius="32"
                                VerticalAlignment="Center">
                            <Border.Clip>
                                <EllipseGeometry Center="32,32"
                                                 RadiusX="32"
                                                 RadiusY="32"/>
                            </Border.Clip>

                            <Grid>
                                <!-- Profile Image dari CurrentUser -->
                                <Image Source="{Binding CurrentUser.Image}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="64"
                                       Height="64"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1.12"
                                                        ScaleY="1.12"/>
                                    </Image.RenderTransform>
                                </Image>

                                <!-- Fallback icon -->
                                <materialDesign:PackIcon Kind="Account"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#0D5785"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentUser.Image}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentUser.Image}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1"
                    Margin="40,0,40,40">
                <!-- Order Table -->
                <Border Background="white"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header -->
                            <RowDefinition Height="*"/>
                            <!-- Data -->
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Grid Grid.Row="0"
                              Background="#0D5785"
                              Margin="20,20,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <!-- Order ID -->
                                <ColumnDefinition Width="150"/>
                                <!-- Date -->
                                <ColumnDefinition Width="*"/>
                                <!-- Order User -->
                                <ColumnDefinition Width="2*"/>
                                <!-- Product Name -->
                                <ColumnDefinition Width="100"/>
                                <!-- Quantity -->
                                <ColumnDefinition Width="150"/>
                                <!-- Payment Method -->
                                <ColumnDefinition Width="150"/>
                                <!-- Payment Price -->
                                <ColumnDefinition Width="100"/>
                                <!-- Action -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Order ID"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="1"
                                       Text="Date"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="2"
                                       Text="Order User"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="3"
                                       Text="Product Name"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="4"
                                       Text="Quantity"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="5"
                                       Text="Payment Method"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="6"
                                       Text="Payment Price"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="7"
                                       Text="Action"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Table Data with ScrollViewer -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="20,10,10,20">
                            <ItemsControl ItemsSource="{Binding OrderItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                CornerRadius="8"
                                                Margin="0,5,10,0"
                                                Padding="0,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding OrderID}"
                                                           FontSize="14"
                                                           Foreground="#333"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                                           FontSize="14"
                                                           Foreground="#333"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding OrderUser}"
                                                           FontSize="14"
                                                           Foreground="#333"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding ProductName}"
                                                           FontSize="14"
                                                           Foreground="#666"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="20"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Quantity}"
                                                           FontSize="14"
                                                           Foreground="#333"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding PaymentMethod}"
                                                           FontSize="14"
                                                           Foreground="#333"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding PaymentPrice, StringFormat={}{0:N0}}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#113F67"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>

                                                <!-- Action Button -->
                                                <Button Grid.Column="7"
                                                        Width="32"
                                                        Height="32"
                                                        Background="#28A745"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="6">
                                                                            <materialDesign:PackIcon Kind="Eye"
                                                                                                     Width="16"
                                                                                                     Height="16"
                                                                                                     Foreground="White"
                                                                                                     HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#218838"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
