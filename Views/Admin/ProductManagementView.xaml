<UserControl x:Class="BOZea.Views.Admin.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:shared="clr-namespace:BOZea.Views.Shared"
             mc:Ignorable="d"
             FontFamily="Plus Jakarta Sans"
             d:DesignWidth="1280"
             d:DesignHeight="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BOZea;component/Views/Styles/MaterialOverrides.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <shared:AdminSidebar Grid.Column="0"
                             DataContext="{Binding}"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header with Add Product Button -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Header - Same as Dashboard -->
            <Border Grid.Row="0"
                    Margin="0,30,0,20"
                    Padding="40,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <!-- Title and Profile -->
                        <RowDefinition Height="Auto"/>
                        <!-- Add Product Button -->
                    </Grid.RowDefinitions>

                    <!-- Top Row: Title and Profile -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Column="0"
                                   Text="Product Management"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="#113F67"
                                   VerticalAlignment="Center"
                                   Margin="0"/>

                        <!-- User Profile -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Cursor="Hand">

                            <StackPanel Margin="0,0,15,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Selamat Datang,"
                                           FontSize="16"
                                           Foreground="#666"
                                           HorizontalAlignment="Right"
                                           Margin="0"/>
                                <TextBlock Text="{Binding AdminName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#113F67"
                                           HorizontalAlignment="Right"
                                           Margin="0"/>
                            </StackPanel>

                            <Border Width="64"
                                    Height="64"
                                    Background="#E8F4F8"
                                    CornerRadius="32"
                                    VerticalAlignment="Center">
                                <Border.Clip>
                                    <EllipseGeometry Center="32,32"
                                                     RadiusX="32"
                                                     RadiusY="32"/>
                                </Border.Clip>

                                <Grid>
                                    <!-- Profile Image dari CurrentUser -->
                                    <Image Source="{Binding CurrentUser.Image}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Width="64"
                                           Height="64"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <ScaleTransform ScaleX="1.12"
                                                            ScaleY="1.12"/>
                                        </Image.RenderTransform>
                                    </Image>

                                    <!-- Fallback icon -->
                                    <materialDesign:PackIcon Kind="Account"
                                                             Width="32"
                                                             Height="32"
                                                             Foreground="#0D5785"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentUser.Image}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentUser.Image}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Row: Add Product Button (Right Aligned) -->
                    <Button Grid.Row="1"
                            Content="+ Add Product"
                            Background="#227DCD"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="20,12"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0"
                            Command="{Binding AddProductCommand}">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3"
                                              Color="#227DCD"/>
                        </Button.Effect>
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Style="{x:Null}"
                                           Text="{Binding}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           FontWeight="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=FontWeight}"
                                           FontSize="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=FontSize}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </Button.ContentTemplate>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="RenderTransformOrigin"
                                        Value="0.5,0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1"
                                                        ScaleY="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="border"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="#1A6BB8"
                                                                                Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 To="1.05"
                                                                                 Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 To="1.05"
                                                                                 Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                                                 To="4"
                                                                                 Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                 To="12"
                                                                                 Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="border"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="#227DCD"
                                                                                Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 To="1"
                                                                                 Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 To="1"
                                                                                 Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                                                 To="2"
                                                                                 Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                 To="8"
                                                                                 Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsPressed"
                                                         Value="True">
                                                    <Setter TargetName="border"
                                                            Property="Background"
                                                            Value="#155A9E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1"
                    CornerRadius="10"
                    Margin="40,0,40,40"
                    VerticalAlignment="Top">
                <!-- Product Table -->
                <Border Background="white"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header -->
                            <RowDefinition Height="*"/>
                            <!-- Data with ScrollViewer -->
                        </Grid.RowDefinitions>

                        <!-- Table Header (Fixed) -->
                        <Grid Grid.Row="0"
                              Background="#0D5785"
                              Margin="20,20,20,0"
                              ZIndex="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <!-- ID -->
                                <ColumnDefinition Width="100"/>
                                <!-- ShopID -->
                                <ColumnDefinition Width="*"/>
                                <!-- Name -->
                                <ColumnDefinition Width="2*"/>
                                <!-- Description -->
                                <ColumnDefinition Width="120"/>
                                <!-- Price -->
                                <ColumnDefinition Width="120"/>
                                <!-- Action -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="ID"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="1"
                                       Text="ShopID"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="2"
                                       Text="Name"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="3"
                                       Text="Description"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="4"
                                       Text="Price"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"/>
                            <TextBlock Grid.Column="5"
                                       Text="Action"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="10,10"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Table Data (Scrollable) -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Products}"
                                          Margin="20,10,10,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                CornerRadius="8"
                                                Margin="0,5,10,0"
                                                Padding="0,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ID}"
                                                           FontSize="14"
                                                           Foreground="#333"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ShopID}"
                                                           FontSize="14"
                                                           Foreground="#333"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Name}"
                                                           FontSize="14"
                                                           Foreground="#333"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Description}"
                                                           FontSize="14"
                                                           Foreground="#666"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="20"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Price, StringFormat={}{0:N0}}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#113F67"
                                                           Margin="10,0"/>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <!-- Edit Button -->
                                                    <Button Width="32"
                                                            Height="32"
                                                            Background="#227DCD"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Effect>
                                                            <DropShadowEffect BlurRadius="4"
                                                                              ShadowDepth="1"
                                                                              Opacity="0.3"
                                                                              Color="#227DCD"/>
                                                        </Button.Effect>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="RenderTransformOrigin"
                                                                        Value="0.5,0.5"/>
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1"
                                                                                        ScaleY="1"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="6">
                                                                                <materialDesign:PackIcon Kind="Pencil"
                                                                                                         Width="16"
                                                                                                         Height="16"
                                                                                                         Foreground="White"
                                                                                                         HorizontalAlignment="Center"
                                                                                                         VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver"
                                                                                         Value="True">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <ColorAnimation Storyboard.TargetName="border"
                                                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                                                To="#1A6BB8"
                                                                                                                Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                                 To="1.1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                                 To="1.1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                                                                                 To="3"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                                                 To="8"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <ColorAnimation Storyboard.TargetName="border"
                                                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                                                To="#227DCD"
                                                                                                                Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                                 To="1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                                 To="1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                                                                                 To="1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                                                 To="4"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed"
                                                                                         Value="True">
                                                                                    <Setter TargetName="border"
                                                                                            Property="Background"
                                                                                            Value="#155A9E"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Delete Button -->
                                                    <Button Width="32"
                                                            Height="32"
                                                            Background="#DC3545"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Effect>
                                                            <DropShadowEffect BlurRadius="4"
                                                                              ShadowDepth="1"
                                                                              Opacity="0.3"
                                                                              Color="#DC3545"/>
                                                        </Button.Effect>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="RenderTransformOrigin"
                                                                        Value="0.5,0.5"/>
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1"
                                                                                        ScaleY="1"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="6">
                                                                                <materialDesign:PackIcon Kind="Delete"
                                                                                                         Width="16"
                                                                                                         Height="16"
                                                                                                         Foreground="White"
                                                                                                         HorizontalAlignment="Center"
                                                                                                         VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver"
                                                                                         Value="True">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <ColorAnimation Storyboard.TargetName="border"
                                                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                                                To="#BD2130"
                                                                                                                Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                                 To="1.1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                                 To="1.1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                                                                                 To="3"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                                                 To="8"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <ColorAnimation Storyboard.TargetName="border"
                                                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                                                To="#DC3545"
                                                                                                                Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                                 To="1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                                 To="1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                                                                                                 To="1"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                                                 To="4"
                                                                                                                 Duration="0:0:0.15"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed"
                                                                                         Value="True">
                                                                                    <Setter TargetName="border"
                                                                                            Property="Background"
                                                                                            Value="#A71D2A"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>