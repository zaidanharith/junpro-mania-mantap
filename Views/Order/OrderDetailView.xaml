<UserControl x:Class="BOZea.Views.Order.OrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FontFamily="Plus Jakarta Sans"
             Background="#F5F5F5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BOZea;component/Views/Styles/MaterialOverrides.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Back Button Style -->
            <Style x:Key="BackButtonStyle"
                    TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="HorizontalAlignment"
                        Value="Left"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Height"
                        Value="45"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Status Badge Style -->
            <Style x:Key="StatusBadgeStyle"
                    TargetType="Border">
                <Setter Property="CornerRadius"
                        Value="12"/>
                <Setter Property="Padding"
                        Value="12,6"/>
                <Setter Property="HorizontalAlignment"
                        Value="Left"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="900"
                Margin="80,40,80,60">
            <StackPanel>
                <!-- Back Button -->
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource BackButtonStyle}"
                        Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#333"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Back to Orders"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="#333"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Page Title -->
                <TextBlock Text="Order Details"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#113F67"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding OrderNumber}"
                           FontSize="14"
                           Foreground="#666"
                           Margin="0,0,0,40"/>

                <!-- Order Information Card -->
                <Border Background="White"
                        CornerRadius="16"
                        Padding="40"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="2"
                                          Opacity="0.08"
                                          Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Section Title -->
                        <TextBlock Text="Order Information"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#113F67"
                                   Margin="0,0,0,24"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column -->
                            <StackPanel Grid.Column="0"
                                    Margin="0,0,20,0">
                                <!-- Order Date -->
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Order Date"
                                               FontSize="13"
                                               Foreground="#999"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='{}{0:dd MMMM yyyy, HH:mm}'}"
                                               FontSize="15"
                                               Foreground="#333"
                                               FontWeight="Medium"/>
                                </StackPanel>

                                <!-- Payment Method -->
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Payment Method"
                                               FontSize="13"
                                               Foreground="#999"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding PaymentMethod}"
                                               FontSize="15"
                                               Foreground="#333"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right Column -->
                            <StackPanel Grid.Column="1"
                                    Margin="20,0,0,0">
                                <!-- Payment Status -->
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Payment Status"
                                               FontSize="13"
                                               Foreground="#999"
                                               Margin="0,0,0,6"/>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border"
                                                    BasedOn="{StaticResource StatusBadgeStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentStatus}"
                                                            Value="Paid">
                                                        <Setter Property="Background"
                                                                Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatus}"
                                                            Value="Pending">
                                                        <Setter Property="Background"
                                                                Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatus}"
                                                            Value="Failed">
                                                        <Setter Property="Background"
                                                                Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PaymentStatus}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentStatus}"
                                                                Value="Paid">
                                                            <Setter Property="Foreground"
                                                                    Value="#065F46"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentStatus}"
                                                                Value="Pending">
                                                            <Setter Property="Foreground"
                                                                    Value="#92400E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentStatus}"
                                                                Value="Failed">
                                                            <Setter Property="Foreground"
                                                                    Value="#991B1B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Buyer Information Card -->
                <Border Background="White"
                        CornerRadius="16"
                        Padding="40"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="2"
                                          Opacity="0.08"
                                          Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Section Title -->
                        <TextBlock Text="Buyer Information"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#113F67"
                                   Margin="0,0,0,24"/>

                        <!-- Buyer Name -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Name"
                                       FontSize="13"
                                       Foreground="#999"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding BuyerName}"
                                       FontSize="15"
                                       Foreground="#333"
                                       FontWeight="Medium"/>
                        </StackPanel>

                        <!-- Buyer Phone -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Phone Number"
                                       FontSize="13"
                                       Foreground="#999"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding BuyerPhone}"
                                       FontSize="15"
                                       Foreground="#333"
                                       FontWeight="Medium"/>
                        </StackPanel>

                        <!-- Buyer Address -->
                        <StackPanel>
                            <TextBlock Text="Shipping Address"
                                       FontSize="13"
                                       Foreground="#999"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding BuyerAddress}"
                                       FontSize="15"
                                       Foreground="#333"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Order Items Card -->
                <Border Background="White"
                        CornerRadius="16"
                        Padding="40"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="2"
                                          Opacity="0.08"
                                          Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Section Title -->
                        <TextBlock Text="Order Items"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#113F67"
                                   Margin="0,0,0,24"/>

                        <!-- Items List -->
                        <ItemsControl ItemsSource="{Binding OrderItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,20"
                                            Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Product Image -->
                                            <Border Grid.Column="0"
                                                    Width="70"
                                                    Height="70"
                                                    CornerRadius="8"
                                                    Background="#F3F4F6">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,70,70"
                                                            RadiusX="8"
                                                            RadiusY="8"/>
                                                </Border.Clip>
                                                <Image Source="{Binding ProductImage}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- Product Info -->
                                            <StackPanel Grid.Column="1"
                                                    Margin="16,0,16,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#333"
                                                           Margin="0,0,0,6"/>
                                                <TextBlock FontSize="14"
                                                        Foreground="#666">
                                                    <Run Text="{Binding Price, StringFormat='Rp {0:N0}'}"/>
                                                    <Run Text=" × "/>
                                                    <Run Text="{Binding Quantity}"/>
                                                </TextBlock>
                                                <Border Margin="0,8,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border"
                                                                BasedOn="{StaticResource StatusBadgeStyle}">
                                                            <Setter Property="Background"
                                                                    Value="#E0E7FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                        Value="Delivered">
                                                                    <Setter Property="Background"
                                                                            Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                        Value="Shipped">
                                                                    <Setter Property="Background"
                                                                            Value="#DBEAFE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                        Value="Confirmed">
                                                                    <Setter Property="Background"
                                                                            Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                        Value="Pending">
                                                                    <Setter Property="Background"
                                                                            Value="#F3F4F6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                        Value="Cancelled">
                                                                    <Setter Property="Background"
                                                                            Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="#5145CD"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                            Value="Delivered">
                                                                        <Setter Property="Foreground"
                                                                                Value="#065F46"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                            Value="Shipped">
                                                                        <Setter Property="Foreground"
                                                                                Value="#1E40AF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                            Value="Confirmed">
                                                                        <Setter Property="Foreground"
                                                                                Value="#92400E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                            Value="Pending">
                                                                        <Setter Property="Foreground"
                                                                                Value="#6B7280"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}"
                                                                            Value="Cancelled">
                                                                        <Setter Property="Foreground"
                                                                                Value="#991B1B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <!-- Price -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TotalPrice, StringFormat='Rp {0:N0}'}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#113F67"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Order Summary -->
                        <StackPanel Margin="0,20,0,0">
                            <!-- Subtotal -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Subtotal"
                                           FontSize="15"
                                           Foreground="#666"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}"
                                           FontSize="15"
                                           Foreground="#666"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1"
                                    Background="#E5E7EB"
                                    Margin="0,12,0,12"/>

                            <!-- Total -->
                            <Grid>
                                <TextBlock Text="Total"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#113F67"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding TotalPrice, StringFormat='Rp {0:N0}'}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBlueBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
