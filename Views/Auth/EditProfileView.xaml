<UserControl x:Class="BOZea.Views.Auth.EditProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FontFamily="Plus Jakarta Sans"
             Background="#F5F5F5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ✅ Import Material Design Resources -->
                <ResourceDictionary Source="pack://application:,,,/BOZea;component/Views/Styles/MaterialOverrides.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Back Button Style - Keep custom (specific untuk back button) -->
            <Style x:Key="BackButtonStyle"
                   TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="HorizontalAlignment"
                        Value="Left"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Height"
                        Value="45"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Remove Photo Button Style -->
            <Style x:Key="RemovePhotoButton"
                   TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="Foreground"
                        Value="#DC2626"/>
                <Setter Property="Padding"
                        Value="16,10"/>
                <Setter Property="FontSize"
                        Value="13"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="Foreground"
                                Value="#B91C1C"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Border Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="100"
                             Height="10"
                             Foreground="{StaticResource PrimaryBlueBrush}"
                             Background="#E0E0E0"/>
                <TextBlock Text="Saving changes..."
                           Foreground="White"
                           FontSize="14"
                           Margin="0,10,0,0"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="900"
                  Margin="80,40,80,60">

                <StackPanel>
                    <!-- Back Button -->
                    <Button Command="{Binding BackCommand}"
                            Style="{StaticResource BackButtonStyle}"
                            Margin="0,0,0,30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#333"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BackButtonText}"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="#333"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Page Title -->
                    <TextBlock Text="Edit Profile"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#113F67"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Update your personal information and settings"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,40"/>

                    <!-- Profile Card -->
                    <Border Background="White"
                            CornerRadius="16"
                            Padding="40">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="2"
                                              Opacity="0.08"
                                              Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Profile Photo Section -->
                            <Grid Grid.Row="0"
                                  Margin="0,0,0,40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Current Photo -->
                                <Grid Grid.Column="0">
                                    <Border Width="120"
                                            Height="120"
                                            CornerRadius="60"
                                            BorderBrush="{StaticResource PrimaryBlueBrush}"
                                            BorderThickness="3"
                                            Background="#F0F0F0">
                                        <Border.Clip>
                                            <EllipseGeometry Center="60,60"
                                                             RadiusX="60"
                                                             RadiusY="60"/>
                                        </Border.Clip>
                                        <Grid>
                                            <!-- Profile Image -->
                                            <Image Source="{Binding ProfileImage}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                            <!-- Fallback icon when no image -->
                                            <materialDesign:PackIcon Kind="AccountCircle"
                                                                     Foreground="#CCCCCC"
                                                                     Width="120"
                                                                     Height="120"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProfileImage}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ProfileImage}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Grid>
                                    </Border>

                                    <!-- Camera Icon Overlay -->
                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="20"
                                            Background="{StaticResource PrimaryBlueBrush}"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,5,5"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding ChangePhotoCommand}"/>
                                        </Border.InputBindings>
                                        <materialDesign:PackIcon Kind="Camera"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Photo Info -->
                                <StackPanel Grid.Column="1"
                                            Margin="30,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Profile Photo"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#333"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="JPG, PNG or GIF. Max size 2MB."
                                               FontSize="13"
                                               Foreground="#999"
                                               Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- ✅ USE PrimaryButton from MaterialOverrides -->
                                        <Button Content="Upload New Photo"
                                                Command="{Binding ChangePhotoCommand}"
                                                Background="{StaticResource LightBlueBrush}"
                                                Foreground="White"
                                                Height="40"
                                                Padding="20,0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Margin="0,0,12,0">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{x:Null}"
                                                               Text="{Binding}"
                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                               FontWeight="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=FontWeight}"
                                                               FontSize="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=FontSize}"/>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="20"
                                                            Padding="{TemplateBinding Padding}"
                                                            TextElement.Foreground="{TemplateBinding Foreground}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource PrimaryBlueBrush}"/>
                                                            <Setter Property="Foreground"
                                                                    Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="Remove Photo"
                                                Command="{Binding RemovePhotoCommand}"
                                                Style="{StaticResource RemovePhotoButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Form Fields -->
                            <StackPanel Grid.Row="1">

                                <!-- Personal Information Section -->
                                <TextBlock Text="Personal Information"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#113F67"
                                           Margin="0,0,0,24"/>

                                <!-- Name & Email -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Full Name"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333"
                                                   Margin="0,0,0,8"/>
                                        <!-- ✅ USE CustomOutlinedTextBox from MaterialOverrides -->
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CustomOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Enter your full name"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Email Address"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333"
                                                   Margin="0,0,0,8"/>
                                        <!-- ✅ USE CustomOutlinedTextBox -->
                                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CustomOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="your@email.com"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Phone -->
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Phone Number"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#333"
                                               Margin="0,0,0,8"/>
                                    <!-- ✅ USE CustomOutlinedTextBox -->
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CustomOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="08123456789"/>
                                </StackPanel>

                                <!-- Address Field -->
                                <StackPanel Margin="0,0,0,32">
                                    <TextBlock Text="Address"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#333"
                                               Margin="0,0,0,8"/>
                                    <!-- ✅ USE CustomOutlinedTextBox with multiline -->
                                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CustomOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Your address"
                                             MinHeight="100"
                                             Height="Auto"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             Padding="20,12"/>
                                </StackPanel>

                                <!-- Divider -->
                                <Rectangle Height="1"
                                           Fill="#E0E0E0"
                                           Margin="0,0,0,32"/>

                                <!-- Change Password Section -->
                                <TextBlock Text="Change Password"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#113F67"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Leave blank if you don't want to change password"
                                           FontSize="13"
                                           Foreground="#999"
                                           Margin="0,0,0,24"/>

                                <!-- Current Password -->
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Current Password"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#333"
                                               Margin="0,0,0,8"/>
                                    <!-- ✅ USE CustomOutlinedPasswordBox -->
                                    <PasswordBox x:Name="CurrentPasswordBox"
                                                 Style="{StaticResource CustomOutlinedPasswordBox}"
                                                 materialDesign:HintAssist.Hint="Enter current password"
                                                 PasswordChanged="PasswordBox_PasswordChanged"
                                                 GotFocus="PasswordBox_GotFocus"
                                                 LostFocus="PasswordBox_LostFocus"/>
                                </StackPanel>

                                <!-- New Password -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="New Password"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333"
                                                   Margin="0,0,0,8"/>
                                        <!-- ✅ USE CustomOutlinedPasswordBox -->
                                        <PasswordBox x:Name="NewPasswordBox"
                                                     Style="{StaticResource CustomOutlinedPasswordBox}"
                                                     materialDesign:HintAssist.Hint="Enter new password"
                                                     PasswordChanged="PasswordBox_PasswordChanged"
                                                     GotFocus="PasswordBox_GotFocus"
                                                     LostFocus="PasswordBox_LostFocus"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Confirm New Password"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333"
                                                   Margin="0,0,0,8"/>
                                        <!-- ✅ USE CustomOutlinedPasswordBox -->
                                        <PasswordBox x:Name="ConfirmPasswordBox"
                                                     Style="{StaticResource CustomOutlinedPasswordBox}"
                                                     materialDesign:HintAssist.Hint="Confirm new password"
                                                     PasswordChanged="PasswordBox_PasswordChanged"
                                                     GotFocus="PasswordBox_GotFocus"
                                                     LostFocus="PasswordBox_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Rectangle Height="1"
                                           Fill="#E0E0E0"
                                           Margin="0,12,0,32"/>

                                <!-- Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cancel button with simple style -->
                                    <Button Grid.Column="0"
                                            Content="Cancel"
                                            Command="{Binding CancelCommand}"
                                            Background="#F5F5F5"
                                            Foreground="#666"
                                            BorderThickness="1"
                                            BorderBrush="#E0E0E0"
                                            Height="50"
                                            Padding="24,0"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            MinWidth="120">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="25"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter x:Name="contentPresenter"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="border"
                                                                Property="Background"
                                                                Value="#DC3545"/>
                                                        <Setter TargetName="border"
                                                                Property="BorderBrush"
                                                                Value="#DC3545"/>
                                                        <Setter Property="Foreground"
                                                                Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed"
                                                             Value="True">
                                                        <Setter TargetName="border"
                                                                Property="Background"
                                                                Value="#BD2130"/>
                                                        <Setter TargetName="border"
                                                                Property="BorderBrush"
                                                                Value="#BD2130"/>
                                                        <Setter Property="Foreground"
                                                                Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- ✅ USE PrimaryButton from MaterialOverrides -->
                                    <Button Grid.Column="1"
                                            Command="{Binding SaveCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            MinWidth="180">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave"
                                                                     Width="16"
                                                                     Height="16"
                                                                     Margin="0,0,8,0"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="White"/>
                                            <TextBlock Text="Save Changes"
                                                       VerticalAlignment="Center"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>